  "{REPO}/firmware/face/retina_post.c",
  "{REPO}/firmware/face/retina_decode.c",
  "{REPO}/firmware/face/fit.c",
  "{REPO}/firmware/face/cpu_warp.c",
  "{REPO}/firmware/face/gallery_exact.c",
  "{REPO}/firmware/face/norm512_skylakex.c",
  "{REPO}/firmware/face/positive64_exact.c",
  "{REPO}/firmware/face/exact_sdot.c",
  "{REPO}/firmware/face/runtime.c",
  "{REPO}/external/libgcc_rv32im_ilp32.a",
  "{REPO}/firmware/loader.c",
  "-o",
  "{OUT}/face.elf"
