[
  "{CC}",
  "-march=rv32im_zicsr_zifencei",
  "-mabi=ilp32",
  "-mno-relax",
  "-msmall-data-limit=0",
  "-nostdlib",
  "-nostartfiles",
  "-O2",
  "-ffreestanding",
  "-fno-tree-loop-distribute-patterns",
  "-fno-builtin",
  "-fno-strict-aliasing",
