  "${CC}",
  "-march=rv32im_zicsr_zifencei",
  "-mabi=ilp32",
  "-mno-relax",
  "-msmall-data-limit=0",
  "-nostdlib",
  "-nostartfiles",
  "-O2",
  "-ffreestanding",
  "-fno-tree-loop-distribute-patterns",
  "-fno-builtin",
  "-fno-strict-aliasing",
  "-ffp-contract=off",
  "-fno-fast-math",
  "-ffunction-sections",
  "-fdata-sections",
  "-Wall",
  "-Wextra",
  "-I",
  "${ROOT}/02_firmware/face_application/source",
  "-Wl,--gc-sections,--no-relax,--build-id=none,-T,${ROOT}/02_firmware/face_application/source/link.ld",
