  "-fstack-usage",
  "${ROOT}/02_firmware/face_application/source/demo.c",
  "${ROOT}/02_firmware/face_application/source/retina_post.c",
  "${ROOT}/02_firmware/face_application/source/retina_decode.c",
  "${ROOT}/02_firmware/face_application/source/fit.c",
  "${ROOT}/02_firmware/face_application/source/cpu_warp.c",
  "${ROOT}/02_firmware/face_application/source/gallery_exact.c",
  "${ROOT}/02_firmware/face_application/source/norm512_skylakex.c",
  "${ROOT}/02_firmware/face_application/source/positive64_exact.c",
  "${ROOT}/02_firmware/face_application/source/exact_sdot.c",
  "${ROOT}/02_firmware/face_application/source/runtime.c",
  "${ROOT}/02_firmware/face_application/lib/libgcc_rv32im_ilp32.a",
  "${ROOT}/02_firmware/face_application/source/loader.c",
  "-o",
  "${OUT}/demo.elf"
]
